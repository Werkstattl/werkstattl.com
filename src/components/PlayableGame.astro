---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  title: string;
  src: string;
  poster: ImageMetadata;
  alt: string;
  hint?: string;
  loadingLabel?: string;
}

const {
  title,
  src,
  poster,
  alt,
  hint = "Runs right here — no install, no account",
  loadingLabel = "Loading…",
} = Astro.props;
---

<div class="game-embed" data-game-src={src}>
  <button
    type="button"
    class="poster"
    data-play-game
    aria-label={`Play ${title} directly on this page`}
  >
    <Image
      src={poster}
      width={580}
      height={725}
      densities={[1, 1.5]}
      alt={alt}
      format="webp"
      class="poster-image"
    />
    <span class="poster-veil" aria-hidden="true"></span>
    <span class="poster-cta" aria-hidden="true">
      <span class="poster-play">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
          <path
            d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.3-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z"
          ></path>
        </svg>
      </span>
      <span class="poster-text">
        <strong>Play now</strong>
        <small>{hint}</small>
      </span>
    </span>
  </button>

  <div class="stage" hidden>
    <div class="stage-bar">
      <span class="stage-title">{title}</span>
      <a class="stage-btn" href={src} target="_blank" rel="noopener">
        Open <span aria-hidden="true">&#8599;</span>
      </a>
      <button type="button" class="stage-btn" data-fullscreen hidden>
        Fullscreen
      </button>
      <button
        type="button"
        class="stage-btn stage-close"
        data-close
        aria-label="Close the game"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <div class="stage-view">
      <p class="stage-loading">{loadingLabel}</p>
      <iframe
        class="frame"
        title={title}
        allow="fullscreen; autoplay; gamepad"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-modals allow-downloads"
      ></iframe>
    </div>
  </div>
</div>

<style>
  .game-embed {
    width: min(100%, 580px);
    margin-inline: auto;
  }

  .poster,
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 580 / 725;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 2rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .poster {
    display: block;
    padding: 0;
    background: none;
    cursor: pointer;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .poster-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.92) 14%,
      rgba(0, 0, 0, 0.55) 26%,
      rgba(0, 0, 0, 0) 52%
    );
    transition: opacity 0.25s ease;
  }

  .poster-cta {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 26px 26px;
    text-align: left;
    color: #fff;
  }

  .poster-play {
    display: grid;
    flex: none;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #fff;
    color: #18181b;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.55);
    animation: play-pulse 2.6s ease-out infinite;
    transition: transform 0.25s ease;
  }

  .poster-play svg {
    margin-left: 3px;
  }

  .poster-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .poster-text strong {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .poster-text small {
    font-size: 0.85rem;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.8);
  }

  .poster:hover .poster-play,
  .poster:focus-visible .poster-play {
    transform: scale(1.08);
  }

  .poster:hover,
  .poster:focus-visible {
    transform: translateY(-4px);
  }

  .poster:focus-visible {
    outline: 3px solid #ff6b4a;
    outline-offset: 4px;
  }

  .stage {
    display: flex;
    flex-direction: column;
    background: #000;
  }

  .stage[hidden] {
    display: none;
  }

  .stage-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    padding: 8px 10px 8px 16px;
    background: #18181b;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.8rem;
  }

  .stage-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }

  .stage-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
    padding: 5px 12px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: inherit;
    font-size: 0.8rem;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .stage-btn:hover,
  .stage-btn:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .stage-btn[hidden] {
    display: none;
  }

  .stage-close {
    padding: 5px 10px;
    font-size: 1.1rem;
  }

  .stage-view {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .stage-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.95rem;
  }

  .frame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .stage:fullscreen {
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
  }

  @keyframes play-pulse {
    40% {
      box-shadow: 0 0 0 14px rgba(255, 255, 255, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
    }
  }

  @media (prefers-color-scheme: dark) {
    .poster,
    .stage {
      border-color: rgba(255, 255, 255, 0.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster,
    .poster-play {
      animation: none;
      transition: none;
    }

    .poster:hover,
    .poster:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  const supportsFullscreen = (el: HTMLElement) =>
    typeof el.requestFullscreen === "function";

  document.querySelectorAll<HTMLElement>(".game-embed").forEach((embed) => {
    const src = embed.dataset.gameSrc;
    const poster = embed.querySelector<HTMLElement>(".poster");
    const stage = embed.querySelector<HTMLElement>(".stage");
    const frame = embed.querySelector<HTMLIFrameElement>(".frame");
    const loading = embed.querySelector<HTMLElement>(".stage-loading");
    const fullscreenBtn = embed.querySelector<HTMLElement>("[data-fullscreen]");
    const closeBtn = embed.querySelector<HTMLElement>("[data-close]");

    if (!src || !poster || !stage || !frame) return;

    const triggers = new Set<HTMLElement>([poster]);
    embed
      .closest("section")
      ?.querySelectorAll<HTMLElement>("[data-play-game]")
      .forEach((trigger) => triggers.add(trigger));

    const start = () => {
      if (!frame.src) frame.src = src;
      poster.hidden = true;
      stage.hidden = false;
      stage.scrollIntoView({ block: "nearest", behavior: "smooth" });
      frame.focus();
    };

    const stop = () => {
      if (document.fullscreenElement === stage) document.exitFullscreen();
      frame.removeAttribute("src");
      if (loading) loading.hidden = false;
      stage.hidden = true;
      poster.hidden = false;
      poster.focus();
    };

    triggers.forEach((trigger) =>
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        start();
      }),
    );

    frame.addEventListener("load", () => {
      if (frame.src && loading) loading.hidden = true;
    });

    closeBtn?.addEventListener("click", stop);

    if (fullscreenBtn && supportsFullscreen(stage)) {
      fullscreenBtn.hidden = false;
      fullscreenBtn.addEventListener("click", () => {
        if (document.fullscreenElement === stage) {
          document.exitFullscreen();
        } else {
          stage.requestFullscreen().catch(() => {
            /* keep playing inline when the request is denied */
          });
        }
      });
    }
  });
</script>
