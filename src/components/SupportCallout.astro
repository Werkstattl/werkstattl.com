---
import Github from "./icons/Github.astro";
import Star from "./icons/Star.astro";

interface Props {
  // "Owner/Repo" of the project that fits the article, e.g. "Werkstattl/OpenBlogware"
  repo?: string;
}

const { repo } = Astro.props;
const repoName = repo?.split("/").at(-1);
---

<section class="support">
  <p class="support-text">
    {
      repo
        ? `Free to read, free to use. If it helped, a star on ${repoName} is one click and helps others find it.`
        : "Free to read, free to use. If it helped, follow us on GitHub — one click, and you will not miss the next guide."
    }
  </p>
  <div class="support-actions">
    {
      repo && (
        <a
          class="btn btn-primary"
          href={`https://github.com/${repo}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Star />
          Star {repoName}
        </a>
      )
    }
    <a
      class:list={["btn", repo ? "btn-secondary" : "btn-primary"]}
      href="https://github.com/werkstattl/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Github />
      Follow @werkstattl
    </a>
  </div>
</section>

<style>
  @reference "tailwindcss";

  .support {
    @apply mt-16 grid justify-items-center gap-4 border-t border-[#d4d2d8] pt-8 text-center dark:border-[#4c4c52];
  }

  .support-text {
    @apply max-w-2xl text-lg text-[#3f3b47] dark:text-[#c3c3c3];
  }

  .support-actions {
    @apply flex flex-wrap justify-center gap-3;
  }

  .support .btn {
    @apply inline-flex items-center gap-2 rounded-full border-solid border-b-0 px-6 py-3 text-lg font-medium no-underline transition-all duration-200;
  }

  .support .btn-primary {
    @apply bg-[#18181b] text-white hover:bg-[#3f3b47] dark:bg-white dark:text-[#18181b] dark:hover:bg-[#dcdae0];
  }

  .support .btn-secondary {
    @apply border border-[#d4d2d8] text-[#18181b] hover:border-[#18181b] hover:bg-[#f2f1ed] dark:border-[#4c4c52] dark:text-white dark:hover:border-white dark:hover:bg-[#2d2d2d];
  }
</style>
