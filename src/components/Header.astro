---
import { Image } from "astro:assets";
import logo from "../assets/logos/werkstattl-logo.webp";
const navbar = [
  {
    title: "Blog",
    url: "/blog/",
  }
];
---

<header id="header" class="py-6 transition-all top-0 sticky z-10">
  <div
    class="flex items-center justify-between px-5 container mx-auto transition-all"
  >
    <a href="/">
      <Image
        src={logo}
        width={404}
        height={100}
        alt="Werkstattl logo"
        format="webp"
        class="w-32 dark:invert"
      />
    </a>
    <nav id="menu" class="dark:text-white">
      <ul class="flex items-center gap-5 lg:gap-7 text-lg">
        {
          navbar.map((page) => {
            const { title, url } = page;
            return (
              <li>
                <a class="hover:opacity-60 transition-opacity" href={url}>
                  {title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const $header = document.querySelector("#header");

  if ($header) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 1) {
        $header.classList.remove("py-6", "bg-transparent");
        $header.classList.add(
          "py-3",
          "shadow-md",
          "bg-white",
          "dark:bg-[#242424]"
        );
      } else if (window.scrollY === 0) {
        $header.classList.remove(
          "py-3",
          "shadow-md",
          "dark:bg-[#242424]",
          "bg-white"
        );
        $header.classList.add("py-6", "bg-transparent");
      }
    });
  }
</script>
