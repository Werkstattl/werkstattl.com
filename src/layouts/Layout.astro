---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = "Werkstattl is a small workshop for open software: developer tools, games and privacy-friendly apps, built with care and shared with everyone.",
  image = "/og-image.png",
  type = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const socialImage = new URL(image, base);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("/#organization", base).href,
      name: "Werkstattl",
      url: new URL("/", base).href,
      logo: new URL("/logos/werkstattl-logo.png", base).href,
      sameAs: ["https://github.com/werkstattl/"],
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#website", base).href,
      name: "Werkstattl",
      url: new URL("/", base).href,
      publisher: { "@id": new URL("/#organization", base).href },
      inLanguage: "en",
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href="/fonts/WorkSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/WorkSans-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#242424"
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Werkstattl" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <Header />
    <main class="bg-white dark:bg-[#242424]">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @reference "tailwindcss";

  @font-face {
    font-family: "Work Sans";
    src: url("/fonts/WorkSans-SemiBold.woff2") format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Work Sans";
    src: url("/fonts/WorkSans-Regular.woff2") format("woff2");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Work Sans";
    src: url("/fonts/WorkSans-Bold.woff2") format("woff2");
    font-weight: bold;
    font-style: normal;
    font-display: swap;
  }
  html {
    font-family: "Work Sans", sans-serif;
    /* Keeps anchor targets clear of the sticky header. */
    scroll-padding-top: 6rem;
    @apply scroll-smooth;
  }

  html::-webkit-scrollbar {
    background: 0 0;
    height: 20px;
    width: 20px;
  }

  html::-webkit-scrollbar-thumb {
    background-clip: content-box;
    border: 7px solid transparent;
    border-radius: 20px;
    box-sizing: content-box;
    min-height: 30px;
    width: 6px;
    background-color: #161616;
  }

  html::-webkit-scrollbar-track {
    border-radius: 20px;
    box-sizing: content-box;
    width: 6px;
    border: 7px solid #fff;
    background-color: #f0f0f0;
  }

  @media (prefers-color-scheme: dark) {
    html::-webkit-scrollbar-thumb {
      background-color: rgb(83, 83, 83);
    }

    html::-webkit-scrollbar-track {
      border: 7px solid #242424;
      background-color: #242424;
    }
  }
</style>
