---
import FastArrowRight from "../../components/icons/FastArrowRight.astro";
// import Layout from "../../layouts/Layout.astro";
import LayoutPage from "../../layouts/LayoutPage.astro";

interface BlogPost {
  frontmatter: {
    title: string;
    published: string;
    updated?: string;
    description: string;
  };
  url: string;
}

const formatDate = (date: string) => new Date(date).toDateString();
const toISODate = (date: string) => new Date(date).toISOString().slice(0, 10);

const posts = Object.values(
  import.meta.glob<BlogPost>("./*.md", { eager: true }),
).sort(
  (a, b) =>
    new Date(b.frontmatter.updated ?? b.frontmatter.published).getTime() -
    new Date(a.frontmatter.updated ?? a.frontmatter.published).getTime(),
);
---

<LayoutPage
  title="Werkstattl's Blog"
  name="Blog"
  description="Check out what's happening in Werkstattl's world."
>
  <section class="py-16 grid gap-5 lg:grid-cols-2 container mx-auto">
    {
      posts.map((article) => {
        const { url, frontmatter } = article;
        return (
          <div class="px-5 grid lg:px-0">
            <article class="bg-[#F2F1ED] hover:bg-[#e4e3df] dark:hover:bg-[#181818] dark:bg-[#2d2d2d] rounded-xl p-5 flex flex-col shadow-lg drop-shadow-lg">
              <div class="flex-1">
                <h2 class="text-3xl font-bold dark:text-white">
                  {frontmatter.title}
                </h2>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  {frontmatter.updated && (
                    <span class="bg-[#ffbf48] text-[#282828] rounded-full px-3 py-1 text-sm font-bold">
                      Updated{" "}
                      <time datetime={toISODate(frontmatter.updated)}>
                        {formatDate(frontmatter.updated)}
                      </time>
                    </span>
                  )}
                  <time
                    datetime={toISODate(frontmatter.published)}
                    class="dark:text-white"
                  >
                    {frontmatter.updated ? "Published " : ""}
                    {formatDate(frontmatter.published)}
                  </time>
                </div>
                <p class="text-lg my-4 dark:text-white">
                  {frontmatter.description}
                </p>
              </div>
              <div class="flex justify-end">
                <a
                  href={url}
                  class="bg-black rounded-full py-3 px-6 text-white flex gap-3 w-fit dark:bg-white dark:text-[#18181b]"
                >
                  Read more
                  <FastArrowRight />
                </a>
              </div>
            </article>
          </div>
        );
      })
    }
  </section>
</LayoutPage>
